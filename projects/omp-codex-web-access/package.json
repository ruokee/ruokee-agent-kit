{
  "name": "@ruokee/omp-codex-web-access",
  "version": "0.3.0",
  "description": "OMP extension letting OMP use a forwarded Codex subscription for web search and page extraction",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "omp-package",
    "web-access"
  ],
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ],
    "settings": {
      "model": {
        "type": "string",
        "default": "",
        "description": "Responses model selector in provider/model format."
      },
      "searchEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Register the codex_web_search tool."
      },
      "searchLoadMode": {
        "type": "enum",
        "values": [
          "essential",
          "discoverable"
        ],
        "default": "essential",
        "description": "How codex_web_search is presented to the model."
      },
      "fetchEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Register the codex_web_fetch tool."
      },
      "fetchLoadMode": {
        "type": "enum",
        "values": [
          "essential",
          "discoverable"
        ],
        "default": "discoverable",
        "description": "How codex_web_fetch is presented to the model."
      }
    }
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.2.3 <19"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.2.3",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  }
}
